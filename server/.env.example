HOST=0.0.0.0
PORT=5000
DEBUG=false
# Include the exact origin used to open the dashboard. For LAN access, add
# its mini-PC address, e.g. http://192.168.0.103:3000.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_PATH=pigs.db

DETECT_MODEL_PATH=models/pig_detect.pt
CLASSIFY_MODEL_PATH=models/pig_classify.pt
DETECT_CONF=0.35
DETECT_IOU=0.5
ALLOW_MISSING_MODELS=true

WEBCAM_INDEX=0
WEBCAM_WIDTH=1280
WEBCAM_HEIGHT=720
WEBCAM_FPS=15
WEBCAM_JPEG_QUALITY=70
INFERENCE_EVERY_N_FRAMES=3

THERMAL_SERIAL_PORT=COM3
THERMAL_SERIAL_BAUD=115200
THERMAL_PIG_THRESHOLD_C=30.0
THERMAL_MIN_HOT_FRACTION=0.05

SNAPSHOTS_DIR=snapshots
DEFAULT_SCHEDULE_ENABLED=false
DEFAULT_SCHEDULE_MODE=interval
DEFAULT_SCHEDULE_INTERVAL_MIN=15
DEFAULT_SCHEDULE_CRON_EXPR=0 8 * * *

THERMAL_BROADCAST_MIN_MS=250
WEBCAM_BROADCAST_MIN_MS=100
